# Database
MONGODB_URI=

# NextAuth (required for session signing): `openssl rand -hex 32`
AUTH_SECRET=

# Google OAuth (optional; leave empty to hide "Continue with Google")
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email OTPs via Resend. Without a key, dev logs OTPs to the server console;
# production refuses to send.
RESEND_API_KEY=
MAIL_FROM="Eclecia'27 <onboarding@your-domain>"

# Self-hosting / `next start` outside Vercel: let Auth.js trust the request host.
AUTH_TRUST_HOST=true

# Feature flags (default: false)
NEXT_PUBLIC_ENABLE_LOADER=false
NEXT_PUBLIC_ENABLE_REGISTRATION=false
